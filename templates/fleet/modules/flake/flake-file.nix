# flake.nix is generated: each aspect declares the inputs it uses on the `flake-file` sink (github:vic/flake-file).
{
  sven,
  lib,
  inputs,
  ...
}:
let
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
  follows = url: {
    inherit url;
    inputs.nixpkgs.follows = "nixpkgs";
  };
in
{
  sven.kinds.fleet.sinks.flake-file = {
    reduce = sven.lib.reduce.merge;
    out =
      { flake-file, ... }:
      let
        e = inputs.nixpkgs-unstable.lib.evalModules {
          # flake-file needs `valueMeta` on submodule options: nixos-25.05 lib lacks it
          specialArgs = { inherit inputs; }; # flake-file reads `inputs.self` (the files it checks)
          modules = [
            inputs.flake-file.flakeModules.flake
            { inherit flake-file; }
            { flake-file.formatter = p: p.nixfmt-rfc-style; } # the formatter of fmt-check: one layout for every nix file
          ];
        };
      in
      {
        packages.x86_64-linux.write-flake = e.config.flake-file.apps.write-flake pkgs;
        checks.x86_64-linux.flake-file = e.config.flake-file.check-flake-file pkgs;
      };
  };
  sven.aspects.fleet-flake = {
    at = sven.fleet.main;
    flake-file = {
      description = "A sven fleet: Ren's fleet, sini's and Den's patterns, as queries";
      outputs = ''
        inputs:
        inputs.sven.lib.mkFlake {
          imports = [ (inputs.import-tree ./modules) ];
          _module.args = {
            inherit inputs;
            inherit (inputs.nixpkgs) lib;
          };
        }
      '';
      do-not-edit = ''
        # DO-NOT-EDIT. Generated by github:vic/flake-file from the `flake-file` sink of modules/.
        # Regenerate: nix run .#write-flake
      '';
      inputs = {
        sven.url = "path:../..";
        import-tree.url = "github:denful/import-tree";
        flake-file.url = "github:vic/flake-file";
        nixpkgs.url = "github:nixos/nixpkgs/nixos-25.05";
      };
    };
  };
  # every other input comes from the aspect that uses it
  sven.aspects.channel-inputs = {
    at = sven.fleet.main;
    flake-file.inputs = {
      nixpkgs-unstable.url = "github:nixos/nixpkgs/nixpkgs-unstable";
      home-manager = follows "github:nix-community/home-manager/release-25.05";
      home-manager-unstable = {
        url = "github:nix-community/home-manager";
        inputs.nixpkgs.follows = "nixpkgs-unstable";
      };
      nix-darwin = follows "github:nix-darwin/nix-darwin/nix-darwin-25.05";
    };
  };
  sven.aspects.platform-inputs = {
    at = sven.fleet.main;
    flake-file.inputs = {
      colmena.url = "github:zhaofengli/colmena";
      nix-on-droid.url = "github:nix-community/nix-on-droid";
      terranix.url = "github:terranix/terranix";
      impermanence.url = "github:nix-community/impermanence";
    };
  };
}
