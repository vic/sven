# .github/workflows/test.yml is generated: each stage is an aspect that gives jobs to the `workflow` sink.
# Stages run one after another (`needs`), so a push never starts every job at once on GitHub's runners:
#   fmt -> engine -> docs -> fleet -> flake-check, and one eval job per system of templates/fleet/ci.json.
{
  sven,
  lib,
  inputs,
  ...
}:
let
  concurrency = {
    group = "\${{ github.workflow }}-\${{ github.ref }}";
    # never cancel main builds: back-to-back merges would leave main untested.
    # On PRs cancel only for new commits: a run cancelled for the same commit
    # before its matrix expands leaves literal `${{ matrix.* }}` checks failed
    # forever, so label/review events queue behind the running build instead.
    cancel-in-progress = "\${{ github.ref != 'refs/heads/main' && github.event.action == 'synchronize' }}";
  };
  setup = [
    {
      uses = "actions/checkout@v4";
      "with".fetch-depth = 0;
    } # full history: the engine's asOf/history tests fetch old revisions
    {
      uses = "cachix/install-nix-action@v31";
      "with".github_access_token = "\${{ secrets.GITHUB_TOKEN }}";
    }
  ];
  job =
    {
      needs ? [ ],
      timeout ? 30,
      runs-on ? "ubuntu-latest",
      pre ? [ ],
      nix ? { },
      steps,
    }:
    {
      inherit runs-on;
      timeout-minutes = timeout;
      steps =
        pre ++ map (s: if s ? "with" then s // { "with" = s."with" // nix; } else s) setup ++ steps; # `nix`: extra install-nix inputs
    }
    // lib.optionalAttrs (needs != [ ]) { inherit needs; };
  dev = name: command: {
    inherit name;
    run = "nix develop ./docs -c ${command}";
  };
  # the fleet's CI targets, grouped by system: one job per system, its targets one after another
  targets = lib.groupBy (t: t.system) (
    builtins.fromJSON (builtins.readFile (inputs.sven + "/templates/fleet/ci.json"))
  );
  runner = {
    x86_64-linux = "ubuntu-latest";
    aarch64-linux = "ubuntu-24.04-arm";
    aarch64-darwin = "macos-latest";
  };
  # a small YAML writer: block style, `|` for multi-line strings, JSON-quoted scalars
  yaml =
    ind: v:
    let
      pad = lib.fixedWidthString ind " " "";
    in
    if lib.isAttrs v then
      lib.concatStrings (lib.mapAttrsToList (k: x: "${pad}${builtins.toJSON k}:" + item ind x) v)
    else
      lib.concatMapStrings (
        x: "${pad}-" + (if lib.isAttrs x then "\n" + yaml (ind + 2) x else item ind x)
      ) v;
  item =
    ind: x:
    if lib.isAttrs x then
      (if x == { } then " {}\n" else "\n" + yaml (ind + 2) x)
    else if lib.isList x then
      "\n" + yaml (ind + 2) x
    else if lib.isString x && lib.hasInfix "\n" x then
      " |\n"
      + lib.concatMapStrings (l: lib.fixedWidthString (ind + 2) " " "" + l + "\n") (
        lib.splitString "\n" (lib.removeSuffix "\n" x)
      )
    else
      " ${builtins.toJSON x}\n";
in
{
  sven.helpers.yaml = yaml 0; # issue forms and other workflows use it too

  # the site: built by the same devshell command as `docs-build` locally, then deployed to GitHub Pages
  sven.aspects.gh-pages = {
    at = sven.kinds.site;
    files.files.file."../.github/workflows/gh-pages.yml".text = ''
      # DO-NOT-EDIT. Generated by docs/modules/ci.nix (the docs fleet). Regenerate: cd docs && nix run .#write-files
    ''
    + yaml 0 {
      name = "GH Pages";
      on = {
        workflow_dispatch = { };
        push = {
          branches = [ "main" ];
          paths = [ "docs/**" ];
        };
      };
      permissions = {
        contents = "read";
        pages = "write";
        id-token = "write";
      };
      concurrency = {
        group = "pages";
        cancel-in-progress = true;
      };
      jobs.deploy = {
        environment = {
          name = "github-pages";
          url = "\${{ steps.deployment.outputs.page_url }}";
        };
        runs-on = "ubuntu-latest";
        timeout-minutes = 30;
        steps = setup ++ [
          (dev "build the site" "docs-build")
          { uses = "actions/configure-pages@v5"; }
          {
            uses = "actions/upload-pages-artifact@v3";
            "with".path = "./docs/dist";
          }
          {
            id = "deployment";
            uses = "actions/deploy-pages@v4";
          }
        ];
      };
    };
  };

  sven.kinds.site.sinks.workflow = {
    reduce = sven.lib.reduce.merge;
    files =
      { workflow, ... }:
      {
        files.file."../.github/workflows/test.yml".text = ''
          # DO-NOT-EDIT. Generated by docs/modules/ci.nix (the docs fleet). Regenerate: cd docs && nix run .#write-files
          # Jobs: ${lib.concatStringsSep ", " (lib.attrNames workflow)}
        ''
        + yaml 0 {
          name = "test";
          on = {
            push = { };
            pull_request = { };
            workflow_dispatch = { };
          };
          inherit concurrency;
          permissions.contents = "read";
          jobs = workflow;
        };
      };
  };

  # every step is one devshell command (modules/devshell.nix): what CI runs, `nix develop ./docs -c <cmd>` runs locally
  sven.aspects.ci-fmt = {
    at = sven.kinds.site;
    workflow.fmt = job {
      steps = [
        (dev "every nix file is formatted (nixfmt)" "fmt-check")
        (dev "the workflows are valid (actionlint)" "lint")
      ];
    };
  };
  sven.aspects.ci-engine = {
    at = sven.kinds.site;
    workflow.engine = job {
      timeout = 20;
      steps = [
        (dev "engine and library oracles" "engine-test")
        (dev "cost oracles (memos)" "engine-cost")
      ];
    };
  };
  sven.aspects.ci-docs = {
    at = sven.kinds.site;
    workflow.docs = job {
      timeout = 60;
      steps = [
        (dev "docs examples" "docs-test")
        (dev "docs flake check: pages and workflows current, examples, e2e" "docs-check")
        (dev "site build" "docs-build")
      ];
    };
  };
  sven.aspects.ci-fleet = {
    at = sven.kinds.site;
    workflow = {
      fleet = job {
        timeout = 120;
        steps = [
          (dev "fleet checks" "fleet-test")
          (dev "real evaluations (e2e)" "fleet-e2e")
          (dev "trimmed module lists cost oracle" "fleet-cost")
          (dev "MCP server and flake app" "fleet-mcp")
        ];
      };
      flake-check = job {
        timeout = 120;
        # no KVM: VM tests are `vmTests`, not checks (hosted runners cannot run guests reliably)
        steps = [ (dev "nix flake check of the fleet" "fleet-check") ];
      };
    }
    // lib.mapAttrs' (
      system: _:
      lib.nameValuePair "eval-${system}" (job {
        needs = [ "fleet" ];
        runs-on = runner.${system};
        steps = [ (dev "every ${system} target of ci.json evaluates" "fleet-eval ${system}") ];
      })
    ) targets;
  };
}
