# Issues carry code. The issue form asks for a yen module; .github/workflows/issue.yml evaluates every ```nix block
# of an issue as one fleet (docs/issue/eval.nix) and comments the answer: errors, scopes, active aspects, invariants.
# The evaluation is pure and restricted (--restrict-eval), with a timeout, and its step holds no token.
{
  yen,
  lib,
  inputs,
  ...
}:
let
  y = yen.helpers.yaml;
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
  dnd =
    what:
    "# DO-NOT-EDIT. Generated by docs/modules/issues.nix (${what}). Regenerate: cd docs && nix run .#write-files\n";
  form = {
    name = "Bug or question";
    description = "Something yen does, or does not do. A yen module that shows it is required.";
    body = [
      {
        type = "markdown";
        attributes.value = "Thanks for writing. CI evaluates every `nix` block of this issue as one yen fleet and comments the answer, so a small module that shows the problem gets a fast reply.";
      }
      {
        type = "textarea";
        id = "module";
        attributes = {
          label = "A yen module";
          description = "A file of `modules/`: `{ yen, lib, ... }: { … }`. Declare the kinds it needs. `lib` is nixpkgs lib.";
          render = "nix";
        };
        validations.required = true;
      }
      {
        type = "textarea";
        id = "more";
        attributes = {
          label = "Another module (optional)";
          render = "nix";
        };
      }
      {
        type = "textarea";
        id = "expected";
        attributes = {
          label = "What you expected";
        };
        validations.required = true;
      }
      {
        type = "textarea";
        id = "got";
        attributes = {
          label = "What you got";
          description = "An error, a value, or the answer of the CI comment.";
        };
        validations.required = true;
      }
    ];
  };
  workflow = {
    name = "issue";
    on.issues.types = [
      "opened"
      "edited"
    ];
    permissions = {
      contents = "read";
      issues = "write";
    };
    jobs.evaluate = {
      "if" = "contains(github.event.issue.body, '```nix')";
      runs-on = "ubuntu-latest";
      timeout-minutes = 10;
      steps = [
        {
          uses = "actions/checkout@v4";
          "with".persist-credentials = false;
        }
        { uses = "cachix/install-nix-action@v31"; }
        {
          name = "evaluate the nix blocks as one fleet (pure, restricted, no token)";
          env.ISSUE_BODY = "\${{ github.event.issue.body }}";
          run = "nix develop ./docs -c issue-eval - \"$RUNNER_TEMP/issue\"";
        }
        {
          name = "comment";
          env = {
            GH_TOKEN = "\${{ github.token }}";
            GH_REPO = "\${{ github.repository }}";
            NUMBER = "\${{ github.event.issue.number }}";
          };
          run = "nix develop ./docs -c issue-comment \"$NUMBER\" \"$RUNNER_TEMP/issue/comment.md\"";
        }
      ];
    };
  };
in
{
  yen.aspects.issues = {
    at = yen.kinds.site;
    files.files.file = {
      "../.github/ISSUE_TEMPLATE/bug.yml".text = dnd "the issue form" + y form;
      "../.github/ISSUE_TEMPLATE/config.yml".text =
        dnd "issue forms only"
        + y {
          blank_issues_enabled = false;
          contact_links = [
            {
              name = "Read the docs first";
              url = "https://github.com/vic/yen/tree/main/docs";
              about = "Every page is a tested example.";
            }
          ];
        };
      "../.github/workflows/issue.yml".text = dnd "the issue evaluator" + y workflow;
    };
    # extract.sh round trip: the sample issue of the contributing page, as GitHub sends it (CRLF), gives back its blocks
    out.checks.x86_64-linux.issue-extract =
      let
        sample = ../examples/contributing/issue;
        blocks = lib.filter (f: lib.hasPrefix "block-" f) (lib.attrNames (builtins.readDir sample));
        body = lib.replaceStrings [ "\n" ] [ "\r\n" ] (
          "Some text.\n\n"
          + lib.concatMapStrings (f: "```nix\n${builtins.readFile (sample + "/${f}")}```\n\ntext\n\n") blocks
          + "```sh\necho not nix\n```\n"
        );
      in
      pkgs.runCommand "issue-extract" { } ''
        printf '%s' ${lib.escapeShellArg body} > body.md
        bash ${../issue/extract.sh} body.md out
        diff -r out ${sample} -x '*.md' && touch $out
      '';
  };
}
