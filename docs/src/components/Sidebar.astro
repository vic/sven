---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;

import { Icon } from '@astrojs/starlight/components';

/** Get the icon for a group, by its position in yen.section order. Update the icon names in the array to change the icons associated with a group. */
const getIcon = (index: number) =>
	(
		[
			'rocket', // Start
			'right-arrow', // Move to yen
			'open-book', // Model
			'setting', // Behavior
			'approve-check', // Principles
			'question', // Ask and prove
			'laptop', // For agents
			'pencil', // Recipes
			'nix', // NixOS patterns in yen
			'puzzle', // Den patterns in yen
			'star', // Battery packs
			'analytics', // Performance
			'magnifier', // Reference
			'github', // Project
		] as const
	)[index] ?? 'document';

/** Determine if an array of sidebar items contains the current page.  */
const isCurrent = (sidebar: SidebarEntry[]): boolean =>
	sidebar
		.map((entry) => (entry.type === 'link' ? entry.isCurrent : isCurrent(entry.entries)))
		.some((entry) => entry === true);

/** The href of the first page in a group, depth first. */
const firstHref = (sidebar: SidebarEntry[]): string | undefined =>
	sidebar
		.map((entry) => (entry.type === 'link' ? entry.href : firstHref(entry.entries)))
		.find((href) => href !== undefined);
---

<SidebarPersister>
	<div class="accordion">
		{
			sidebar.map(({ label, entries }, index) => (
				// a shared `name` makes the sections exclusive: opening one closes the others
				<details name="sidebar-section" open={isCurrent(entries)} class="section">
					<summary data-href={firstHref(entries)}>
						<Icon class="icon" name={getIcon(index)} />
						<span class="label">{label}</span>
						<Icon class="caret" name="right-caret" size="1.25rem" />
					</summary>
					<div class="panel">
						<SidebarSublist sublist={entries} />
					</div>
				</details>
			))
		}
	</div>
</SidebarPersister>

<script>
	// opening a section goes to its first page; closing it only collapses
	document.querySelectorAll<HTMLElement>('.section > summary[data-href]').forEach((summary) =>
		summary.addEventListener('click', () => {
			if (!(summary.parentElement as HTMLDetailsElement).open) location.href = summary.dataset.href!;
		})
	);
</script>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
	/** Add "EN" to the end of sidebar items with the `fallback` class. */
	:global(.fallback)::after {
		content: 'EN';
		vertical-align: super;
		font-size: 0.75em;
		font-weight: 700;
	}

	/* Scroll when needed, with no visible scrollbar: the gutter was forced on before. */
	:global(.sidebar-pane) {
		overflow-y: auto;
		scrollbar-width: none;
	}
	:global(.sidebar-pane::-webkit-scrollbar) {
		display: none;
	}

	/* The accordion keeps the tab switcher look: one framed list, each section a tab item. */
	.accordion {
		/* Layout variables */
		--tab-switcher-border-width: 1px;
		--tab-switcher-padding: calc(0.25rem - var(--tab-switcher-border-width));
		--tab-item-border-radius: 0.5rem;
		--tab-switcher-border-radius: calc(
			var(--tab-item-border-radius) + var(--tab-switcher-padding) + var(--tab-switcher-border-width)
		);

		/* Color variables */
		--tab-switcher-border-color: var(--sl-color-hairline-light);
		--tab-switcher-background-color: var(--sl-color-gray-7, var(--sl-color-gray-6));
		--tab-switcher-text-color: var(--sl-color-gray-3);
		--tab-switcher-text-color--active: var(--sl-color-white);
		--tab-switcher-icon-color: var(--sl-color-gray-4);
		--tab-switcher-icon-color--active: var(--sl-color-text-accent);
		--tab-item-background-color--hover: var(--sl-color-gray-6);
		--tab-item-background-color--active: var(--sl-color-black);

		/* lets `height: auto` animate where supported */
		interpolate-size: allow-keywords;
		border: var(--tab-switcher-border-width) solid var(--tab-switcher-border-color);
		border-radius: var(--tab-switcher-border-radius);
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: var(--tab-switcher-padding);
		background-color: var(--tab-switcher-background-color);
		margin-bottom: 1.5rem;
	}
	/* Dark theme variations */
	:global([data-theme='dark']) .accordion {
		--tab-switcher-text-color: var(--sl-color-gray-2);
		--tab-switcher-icon-color: var(--sl-color-gray-3);
		--tab-item-background-color--hover: var(--sl-color-gray-5);
	}

	@media (min-width: 50rem) {
		/* Dark theme variations with the desktop sidebar visible */
		:global([data-theme='dark']) .accordion {
			--tab-switcher-background-color: var(--sl-color-black);
			--tab-item-background-color--hover: var(--sl-color-gray-6);
			--tab-item-background-color--active: var(--sl-color-gray-6);
		}
	}

	.section {
		border: var(--tab-switcher-border-width) solid transparent;
		border-radius: var(--tab-item-border-radius);
		background-clip: padding-box;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}
	.section[open] {
		border-color: var(--tab-switcher-border-color);
		background-color: var(--tab-item-background-color--active);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: calc(0.5rem - var(--tab-switcher-border-width));
		border-radius: var(--tab-item-border-radius);
		cursor: pointer;
		list-style: none;
		user-select: none;
		line-height: var(--sl-line-height-headings);
		color: var(--tab-switcher-text-color);
		font-weight: 600;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover {
		color: var(--tab-switcher-text-color--active);
		background-color: var(--tab-item-background-color--hover);
	}
	summary:focus-visible {
		outline: 2px solid var(--tab-switcher-icon-color--active);
		outline-offset: -2px;
	}
	.section[open] > summary {
		color: var(--tab-switcher-text-color--active);
	}
	.section[open] > summary:hover {
		background-color: transparent;
	}

	.label {
		flex: 1;
	}

	.icon {
		margin: 0.25rem;
		color: var(--tab-switcher-icon-color);
	}
	summary:hover .icon {
		color: inherit;
	}
	.section[open] .icon {
		color: var(--tab-switcher-icon-color--active);
	}

	.caret {
		color: var(--tab-switcher-icon-color);
		transition: transform 0.2s ease;
	}
	.section[open] .caret {
		transform: rotate(90deg);
	}
	:global([dir='rtl']) .caret {
		transform: rotate(180deg);
	}
	:global([dir='rtl']) .section[open] .caret {
		transform: rotate(90deg);
	}

	/* open and close with a height slide where the browser supports ::details-content */
	.section::details-content {
		block-size: 0;
		overflow-y: clip;
		transition:
			block-size 0.3s ease,
			content-visibility 0.3s allow-discrete;
	}
	.section[open]::details-content {
		block-size: auto;
	}

	.panel {
		padding: 0.25rem 0.25rem 0.5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.section,
		.caret,
		.section::details-content {
			transition: none;
		}
	}
</style>
